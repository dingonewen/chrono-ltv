# ── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=chrono-ltv-survival

# ── Data Simulator ──────────────────────────────────────────────────────────
SIMULATOR_RANDOM_SEED=42
SIMULATOR_N_CUSTOMERS=10000
SIMULATOR_OUTPUT_DIR=data/raw

# ── Embedding Model ─────────────────────────────────────────────────────────
# Set to "local" to use sentence-transformers offline, "openai" for API-backed
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# OPENAI_API_KEY=sk-...  # only needed if EMBEDDING_BACKEND=openai

# ── Serving ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MODEL_REGISTRY_URI=models:/chrono-ltv-cox/Production

# ── Monitoring ──────────────────────────────────────────────────────────────
DRIFT_PSI_THRESHOLD=0.2
DRIFT_REPORT_DIR=reports/drift

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
